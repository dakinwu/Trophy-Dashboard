# Copy this file to `.env` (in the repo root; .env is gitignored) and fill in.
#
# PSN NPSSO token — used by the backend to read YOUR own trophies + playtime
# from the official PlayStation Network API.
# How to get it: log into playstation.com in your browser, then open
# https://ca.account.sony.com/api/v1/ssocookie and copy the "npsso" value below.
# Refresh it when it expires. Never share the token or the cookie response.
PSN_NPSSO=

# If an official public summary is unavailable, other profiles fall back to
# PSNProfiles through visible Chrome. Challenges may require manual verification.
PSNPROFILES_HEADLESS=false
PSNPROFILES_BROWSER_TIMEOUT=180

# Optional but recommended for Trophy Advisor. Create a key in Google AI Studio.
# The backend resolves localized names to canonical English game titles before
# opening PSNProfiles. Never expose this value through VITE_* variables.
GEMINI_API_KEY=
GEMINI_GROUNDING_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60

# Local personal use only. The backend has no multi-user access control.
# Do not expose it publicly, through a tunnel, or via port forwarding.
