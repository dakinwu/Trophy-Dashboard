# Copy to .env (which is gitignored) and fill in real values.
# PSN NPSSO token — get it by logging into playstation.com, then visiting
# https://ca.account.sony.com/api/v1/ssocookie and copying the "npsso" value.
PSN_NPSSO=
# Where cached JSON is written (relative to backend/).
CACHE_DIR=data_cache
# Allowed frontend origins for CORS (JSON list).
CORS_ORIGINS=["http://localhost:5173"]
# PSNProfiles fallback uses a visible Chrome window because Cloudflare detects
# headless automation. Increase this on slower challenge pages if needed.
PSNPROFILES_HEADLESS=false
PSNPROFILES_BROWSER_TIMEOUT=180
# Trophy Advisor title resolver (backend-only; results are cached for 180 days).
GEMINI_API_KEY=
GEMINI_GROUNDING_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60
